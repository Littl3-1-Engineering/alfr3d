[Unit]
Description=ALFR3D container stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Edit to the alfr3d repo path on this host before installing.
WorkingDirectory=/opt/alfr3d
ExecStart=/usr/bin/docker compose up -d
Restart=on-failure
RestartSec=30
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
