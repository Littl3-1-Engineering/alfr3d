[Unit]
Description=ALFR3D container stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Edit to the alfr3d repo path on this host before installing.
WorkingDirectory=/opt/alfr3d
# Rebuild before every start so a deploy-by-patch can never leave a stale image running (a stale
# service-tls ignored TLS_ONESHOT, never exited, and held nginx back through two power outages).
# The leading "-" tolerates a failed build (e.g. no network at boot): start with the existing images.
ExecStartPre=-/usr/bin/docker compose build
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=30
# Finite on purpose: TimeoutStartSec=0 let a stuck dependency wait hang the unit forever.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
