LOG_LEVEL=INFO

# MYSQL Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=mysql
MYSQL_USER=user
MYSQL_PSWD=password
MYSQL_NAME=alfr3d_db
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Zookeeper
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# Kafka
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_LISTENERS_1=//0.0.0.0:29092
KAFKA_LISTENERS_2=//0.0.0.0:9092
KAFKA_ADVERTISED_LISTENERS_1=//kafka:29092
KAFKA_ADVERTISED_LISTENERS_2=//localhost:9092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Services
MYSQL_DATABASE=mysql
MYSQL_NAME=alfr3d_db
MYSQL_USER=user
MYSQL_PSWD=password

# LAN scan IP prefixes (comma-separated, used by service_device)
LAN_IP_PREFIXES=192.,10.
KAFKA_BOOTSTRAP_SERVERS_1=kafka:29092
KAFKA_BOOTSTRAP_SERVERS_2=localhost:9092

# Frontend
SECRET_KEY=your-secret-key
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# Secrets-at-rest encryption key (Fernet, services/common/secrets_utils.py). Optional -- if
# unset, auto-generated on first boot and persisted to the secrets_data Docker volume. Set this
# explicitly only if you need to manage the key yourself (e.g. k8s secret injection).
# ALFR3D_SECRETS_KEY=

# Environment name for deployed instances
ALFR3D_ENV_NAME=Alfr3d-Cassiopeia

# Google Integrations
CLIENT_ID=your-google-client-id
CLIENT_SECRET=your-google-client-secret

# Google Smart Home (Service Account)
# Path to the service account JSON key file for HomeGraph API
GOOGLE_SA_CREDENTIALS_PATH=/secrets/google-smarthome-sa.json

# Speak Service
AUDIO_STORAGE_PATH=/tmp/audio
AUDIO_RETENTION_MINUTES=30

# Camera Streaming (service_api) - no longer configured via env var. Each camera's RTSP
# URL is set on its `device` row (device_type = 'camera') via the Domain > Devices UI or
# PUT /api/devices/{id}; the Nexus camera panel lists/streams whichever devices have one set.

# Daemon Service - household_events durable event log (SA-11)
HOUSEHOLD_EVENTS_RETENTION_DAYS=90

# Daemon Service - attention_telemetry_history (SA-2)
ATTENTION_TELEMETRY_HISTORY_RETENTION_DAYS=90
